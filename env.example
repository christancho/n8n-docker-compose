# =============================================================================
# n8n Docker Compose Environment Variables Configuration
# =============================================================================
# 
# This file contains all the environment variables needed to run the n8n stack.
# Copy this file to .env and update the values with your actual configuration.
#
# IMPORTANT: Never commit the .env file to version control as it contains
# sensitive information like passwords and encryption keys.
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database settings for n8n data storage
# =============================================================================

# PostgreSQL root user credentials
# This is the main database administrator user
POSTGRES_USER=postgres

# PostgreSQL root user password
# Use a strong, unique password for security
POSTGRES_PASSWORD=your_secure_postgres_password

# PostgreSQL database name for n8n
# This is the database where n8n will store all its data
POSTGRES_DB=n8n

# PostgreSQL non-root user for n8n application
# This user will be created and used by n8n to connect to the database
POSTGRES_NON_ROOT_USER=n8n_user

# PostgreSQL non-root user password
# Use a strong, unique password different from the root password
POSTGRES_NON_ROOT_PASSWORD=your_secure_n8n_user_password

# =============================================================================
# N8N CORE CONFIGURATION
# =============================================================================
# Essential settings for n8n application functionality
# =============================================================================

# n8n encryption key for securing sensitive data
# MUST be exactly 32 characters long for proper encryption
# Generate a random 32-character string for production use
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Timezone for n8n application
# Use standard timezone identifiers (e.g., America/Toronto, Europe/London)
TIMEZONE=America/Toronto

# User ID for file permissions (Linux/Unix systems)
# Usually 1000 for the first user, check with 'id -u' command
PUID=1000

# Group ID for file permissions (Linux/Unix systems)
# Usually 1000 for the first user, check with 'id -g' command
PGID=1000

# =============================================================================
# WEBHOOK AND HOST CONFIGURATION
# =============================================================================
# Settings for webhook URLs and external access
# =============================================================================

# Complete webhook URL for n8n workflows
# This is the full URL where external services will send webhook data
# Example: https://n8n.yourdomain.com or https://yourdomain.com:5678
WEBHOOK_URL=https://your-domain.com

# Hostname or IP address where n8n is accessible
# This should match your domain name or server IP
# Example: n8n.yourdomain.com or 192.168.1.100
N8N_HOST=your-domain.com

# Port number where n8n web interface is accessible
# Default is 5678, change if you're using a different port
N8N_PORT=5678

# Protocol for n8n access (http or https)
# Use https for production deployments with SSL certificates
N8N_PROTOCOL=https

# =============================================================================
# DIRECTORY CONFIGURATION
# =============================================================================
# File system paths for data storage
# =============================================================================

# Base directory for all n8n data storage
# This directory will contain n8n data, PostgreSQL data, and Redis data
# Example: /opt/n8n or /home/user/n8n-data
N8N_DIR=/opt/n8n

# =============================================================================
# OPTIONAL: LOGGING CONFIGURATION
# =============================================================================
# Settings for application logging and debugging
# =============================================================================

# Log level for n8n application
# Options: error, warn, info, verbose, debug, silly
# Use 'info' for normal operation, 'debug' for troubleshooting
N8N_LOG_LEVEL=info

# =============================================================================
# OPTIONAL: SECURITY CONFIGURATION
# =============================================================================
# Security-related settings for n8n deployment
# =============================================================================

# Enable secure cookies for HTTPS deployments
# Set to true if using HTTPS, false for HTTP or development
N8N_SECURE_COOKIE=false

# Trust proxy headers (useful behind reverse proxies)
# Set to true if n8n is behind a reverse proxy like nginx or traefik
N8N_TRUST_PROXY=true

# =============================================================================
# OPTIONAL: PERFORMANCE CONFIGURATION
# =============================================================================
# Settings to optimize n8n performance and resource usage
# =============================================================================

# Binary data storage mode
# Options: filesystem (default), s3, gcs
# Use filesystem for local storage, cloud options for scalability
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Maximum number of execution data records to keep
# Helps manage database size by limiting historical data
N8N_EXECUTION_DATA_PRUNE_MAX_COUNT=10000

# Maximum age of execution data in hours
# Data older than this will be automatically pruned
N8N_EXECUTION_DATA_MAX_AGE=168

# =============================================================================
# OPTIONAL: FEATURE CONFIGURATION
# =============================================================================
# Settings to enable/disable various n8n features
# =============================================================================

# Enable personalization features
# Set to false to disable user personalization options
N8N_PERSONALIZATION_ENABLED=false

# Enable version update notifications
# Set to false to disable update notifications in the UI
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# Enable workflow templates
# Set to false to disable the templates feature
N8N_TEMPLATES_ENABLED=false

# Disable onboarding flow for new users
# Set to true to skip the initial setup wizard
N8N_ONBOARDING_FLOW_DISABLED=true

# Enable diagnostic data collection
# Set to false to disable diagnostic data collection
N8N_DIAGNOSTICS_ENABLED=false

# Enable metrics collection
# Set to true to enable Prometheus metrics endpoint
N8N_METRICS=true

# Prefix for metrics labels
# Used when metrics are enabled to organize metric names
N8N_METRICS_PREFIX=n8n_

# Block environment variable access in nodes
# Set to false to allow nodes to access environment variables
N8N_BLOCK_ENV_ACCESS_IN_NODE=false


