# n8n Docker Compose Environment Variables
# Copy this file to .env and update the values according to your setup

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=your_secure_n8n_user_password

# =============================================================================
# N8N CONFIGURATION
# =============================================================================
# Encryption key for n8n (generate a secure random string)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Timezone (default: America/Toronto)
TIMEZONE=America/Toronto

# User and Group IDs (usually 1000 for both)
PUID=1000
PGID=1000

# Webhook URL (replace with your domain)
WEBHOOK_URL=https://your-domain.com

# =============================================================================
# DIRECTORY CONFIGURATION
# =============================================================================
# Base directory for n8n data (adjust path as needed)
N8N_DIR=/opt/n8n

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Uncomment and modify these if you need custom settings
# N8N_LOG_LEVEL=info
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=false
